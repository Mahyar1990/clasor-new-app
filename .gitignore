# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated bundles and browser captures.
/ds-bundle/
/.playwright-mcp/

# Local agent configuration and generated export archives.
# Keep QA evidence referenced by project documentation versioned.
/.codex/config.toml
/.codex/exports/

# Browser test output and local caches.
/playwright-report/
/test-results/
/blob-report/
/.cache/
/.turbo/
*.log

# Local editor and operating-system files.
/.idea/
/.vscode/
*.swp
*.swo
*~
Thumbs.db

# Private keys and local certificates.
*.key
*.p12
*.pfx
id_rsa
id_ed25519
